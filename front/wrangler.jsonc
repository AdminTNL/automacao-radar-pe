{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "radar-pe-front",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-18",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SUPABASE_URL": "https://database.tnledu.shop"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
