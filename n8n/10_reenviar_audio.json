    {
      "parameters": {
        "jsCode": "// Segredo compartilhado com o Worker do Cloudflare (env N8N_AUDIO_RESEND_WEBHOOK_SECRET).\n// Troque 'TROQUE_PELO_SEGREDO' pelo mesmo valor configurado no Worker.\nconst SECRET = 'TROQUE_PELO_SEGREDO';\n\nconst item = $input.first().json || {};\nconst headers = item.headers || {};\n\nconst headerName = Object.keys(headers).find((k) => k.toLowerCase() === 'x-radar-secret');\nif (!headerName || headers[headerName] !== SECRET) {\n  throw new Error('x-radar-secret invalido ou ausente');\n}\n\nconst body = item.body || item;\nconst audio_save_id = body.id || '';\nif (!audio_save_id) {\n  throw new Error('id ausente');\n}\n\nreturn [{ json: { audio_save_id } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "id": "d1a1b1c1-0002-4000-8000-000000000010",
      "name": "Auth + Parse"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://database.tnledu.shop/rest/v1/radar_pe_audio_saves",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "id",
              "value": "={{ 'eq.' + $json.audio_save_id }}"
            },
            {
              "name": "select",
              "value": "id,instance_name,remote_jid,contact_name,phone,audio_msg_id,audio_ts,status"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        440,
        0
      ],
      "id": "d1a1b1c1-0003-4000-8000-000000000010",
      "name": "Get Row",
      "credentials": {
        "supabaseApi": {
          "id": "2s75u9F7plz4ovFN",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const row = $input.first().json || {};\n\nif (!row || !row.id) {\n  return [{ json: { ok: false, error: 'Áudio não encontrado' } }];\n}\nif (row.status === 'salvo') {\n  return [{ json: { ok: false, error: 'Áudio já salvo' } }];\n}\n\nreturn [{ json: {\n  ok: true,\n  instance_name: row.instance_name,\n  audio_msg_id: row.audio_msg_id,\n  contact_name: row.contact_name,\n  phone: row.phone,\n  audio_ts: row.audio_ts,\n  save_id: row.id,\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
