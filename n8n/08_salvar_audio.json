    {
      "parameters": {
        "jsCode": "// Só mensagens NOSSAS que contenham um emoji-gatilho ativo (contém, como as\n// frases-gatilho do radar). Roda antes de qualquer consulta na base.\nconst t = $('Trigger').first().json || {};\n\nconst norm = (s) => (s || '').replace(/\\uFE0F/g, '').trim();\nconst body = norm(t.p_body || '');\n\nif (!t.p_from_me) return [];\n\nconst hits = ($('Get Triggers').all().map((i) => i.json.emoji) || [])\n  .map((e) => ({ raw: e, n: norm(e) }))\n  .filter((e) => e.n && body.includes(e.n))\n  .sort((a, b) => b.n.length - a.n.length);\n\nif (!hits.length) return [];\nconst triggerEmoji = hits[0].raw;\n\nreturn [{\n  json: {\n    instance_name: t.p_instance_name,\n    remote_jid: t.p_remote_jid,\n    contact_name: t.p_contact_name || null,\n    phone: t.p_phone || null,\n    trigger_msg_id: t.p_msg_id,\n    trigger_emoji: triggerEmoji,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "id": "d1a1b1c1-0004-4000-8000-000000000008",
