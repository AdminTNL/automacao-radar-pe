      "parameters": {
        "jsCode": "// Junta o emoji-gatilho com o áudio achado. Sem áudio (audio_msg_id vazio/ausente)\n// encerra o fluxo sem efeito.\nconst t = $('É gatilho?').first().json || {};\nconst row = $input.first().json || {};\n\nif (!row || !row.audio_msg_id) return [];\n\nreturn [{\n  json: {\n    instance_name: t.instance_name,\n    remote_jid: t.remote_jid,\n    contact_name: row.contact_name || t.contact_name,\n    phone: row.phone || t.phone,\n    trigger_msg_id: t.trigger_msg_id,\n    audio_msg_id: row.audio_msg_id,\n    audio_ts: row.audio_ts,\n    trigger_emoji: t.trigger_emoji,\n  },\n}];"
      },
