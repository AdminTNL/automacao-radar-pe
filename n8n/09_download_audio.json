      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "id": "d1a1b1c1-0001-4000-8000-000000000009",
      "name": "Trigger"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT m.key AS key, m.message AS message\nFROM \"Message\" m\nJOIN \"Instance\" i ON i.\"id\" = m.\"instanceId\"\nWHERE i.\"name\" = $1\n  AND m.key->>'id' = $2\nLIMIT 1",
        "options": {
          "queryReplacement": "={{ $('Trigger').first().json.instance_name }},{{ $('Trigger').first().json.audio_msg_id }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        220,
        0
      ],
      "id": "d1a1b1c1-0002-4000-8000-000000000009",
      "name": "Busca Mensagem Evo",
      "credentials": {
        "postgres": {
          "id": "xp5XUZ1wC4LcoiBl",
          "name": "admin evo"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Normaliza o jsonb do Postgres (vem como objeto ou string JSON) e monta o\n// objeto completo da mensagem pro getBase64FromMediaMessage.\nconst row = $input.first().json || {};\nconst parse = (v) => (typeof v === 'string' ? JSON.parse(v) : v);\nconst key = parse(row.key);\nconst message = parse(row.message);\n\nif (!key || !message) return [];\n\nreturn [{ json: { full_message: { key, message } } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "id": "d1a1b1c1-0003-4000-8000-000000000009",
      "name": "Monta Mensagem"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://evolution.tnledu.shop/chat/getBase64FromMediaMessage/{{ encodeURIComponent($('Trigger').first().json.instance_name) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "evolutionApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: $('Monta Mensagem').first().json.full_message, convertToMp4: false }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        660,
        0
      ],
      "id": "d1a1b1c1-0004-4000-8000-000000000009",
      "name": "FindMedia",
      "onError": "continueRegularOutput",
      "credentials": {
        "evolutionApi": {
          "id": "QgTe0fvaWVxshbUk",
          "name": "Admin acesso geral"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "d1a1b1c1-0005-4000-8000-000000000009",
              "leftValue": "={{ (($json.media && $json.media.base64) || $json.base64) ? 'true' : 'false' }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        0
      ],
      "id": "d1a1b1c1-0006-4000-8000-000000000009",
      "name": "Download OK?"
    },
    {
      "parameters": {
        "jsCode": "// Converte o base64 da Evolution em binary p/ upload no Drive. Lê as duas\n// formas de resposta (base64 no topo ou em media.base64) e remove o prefixo\n// 'data:...;base64,' se a Evolution o incluir.\nconst media = $input.first().json || {};\nlet b64 = media.base64 || (media.media && media.media.base64) || '';\nif (typeof b64 === 'string') b64 = b64.replace(/^data:[^,]*;base64,/, '');\nconst mimetype = media.mimetype || (media.media && media.media.mimetype) || 'audio/ogg; codecs=opus';\n\nlet ext = '.ogg';\nconst mm = (mimetype || '').toLowerCase();\nif (mm.includes('m4a')) ext = '.m4a';\nelse if (mm.includes('aac')) ext = '.aac';\nelse if (mm.includes('mp3') || mm.includes('mpeg')) ext = '.mp3';\nelse if (mm.includes('opus')) ext = '.opus';\nelse if (mm.includes('ogg')) ext = '.ogg';\nelse if (mm.includes('webm')) ext = '.webm';\nelse if (mm.includes('wav')) ext = '.wav';\n\nconst sanitize = (s) => (s || '').toString()\n  .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n  .replace(/[^a-zA-Z0-9._-]+/g, '_')\n  .replace(/^_+|_+$/g, '');\n\nconst det = $('Trigger').first().json || {};\nconst d = det.audio_ts ? new Date(det.audio_ts) : new Date();\nconst pad = (n) => String(n).padStart(2, '0');\nconst stamp = `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}_${pad(d.getHours())}h${pad(d.getMinutes())}`;\nconst who = sanitize(det.contact_name) || sanitize(det.phone) || 'contato';\nconst filename = `${stamp}_${sanitize(det.instance_name)}_${who}${ext}`;\n\nreturn [{\n  json: {\n    filename,\n    mimetype,\n    save_id: det.save_id,\n  },\n  binary: {\n    data: {\n      data: Buffer.from(b64, 'base64'),\n      mimeType: mimetype || 'application/octet-stream',\n      fileName: filename,\n    },\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "id": "d1a1b1c1-0007-4000-8000-000000000009",
      "name": "To Binary"
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "upload",
        "inputDataFieldName": "data",
        "name": "={{ $('To Binary').first().json.filename }}",
        "parents": "1zRE-ZiyvfWO60sj4lwRZefX-vkZvWe7v",
        "options": {}
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        1320,
        0
      ],
      "id": "d1a1b1c1-0008-4000-8000-000000000009",
      "name": "Google Drive Upload",
      "onError": "continueRegularOutput",
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "SELECIONE_CREDENCIAL_GOOGLE_DRIVE",
          "name": "Google Drive (selecionar)"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "d1a1b1c1-0009-4000-8000-000000000009",
              "leftValue": "={{ $json.id ? 'true' : 'false' }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
