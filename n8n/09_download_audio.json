    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://database.tnledu.shop/rest/v1/rpc/radar_pe_mark_audio_save",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
