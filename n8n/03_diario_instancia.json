        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://evolution.tnledu.shop/chat/findMessages/{{ encodeURIComponent($('Trigger').item.json.instance_name) }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "remoteJid",
              "value": "={{ $('Loop Chats').item.json.id }}"
            },
            {
              "name": "page",
              "value": "1"
            },
            {
              "name": "offset",
              "value": "300"
            }
          ]
        },
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        800,
        0
      ],
      "id": "ce69731f-de26-4d82-bc21-ca1fb21900cc",
      "name": "Find Messages"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.all();\n\nlet msgs;\nif (raw.length === 1 && Array.isArray(raw[0].json.messages)) {\n  msgs = raw[0].json.messages;\n} else {\n  msgs = raw.map((i) => i.json);\n}\n\nconst existingItem = $('Get Existing').item.json || {};\nconst prevTranscript = existingItem.transcript || '';\nconst prevTs = existingItem.checkpoint\n  ? Math.floor(new Date(existingItem.checkpoint).getTime() / 1000)\n  : 0;\n\nconst rows = msgs\n  .map((m) => {\n    const msg = m.message || {};\n    const body =\n      msg.conversation ||\n      (msg.extendedTextMessage && msg.extendedTextMessage.text) ||\n      (msg.imageMessage && msg.imageMessage.caption) ||\n      (msg.videoMessage && msg.videoMessage.caption) ||\n      (msg.documentMessage && msg.documentMessage.caption) ||\n      (msg.audioMessage ? '[audio]' : '') ||\n      (msg.stickerMessage ? '[figurinha]' : '') ||\n      (msg.locationMessage ? '[localizacao]' : '') ||\n      '';\n    const ts = Number(m.messageTimestamp);\n    return { ts: isFinite(ts) ? ts : 0, fromMe: !!(m.key && m.key.fromMe), body };\n  })\n  .filter((r) => r.body && r.ts > prevTs)\n  .sort((a, b) => a.ts - b.ts);\n\nif (rows.length === 0) {\n  return [];\n}\n\nconst newText = rows.map((r) => (r.fromMe ? 'Eu' : 'Contato') + ': ' + r.body).join('\\n');\nconst merged = prevTranscript ? prevTranscript + '\\n' + newText : newText;\nconst toIso = (ts) => new Date(ts * 1000).toISOString();\nconst lastTs = rows[rows.length - 1].ts;\n\nreturn [\n  {\n    json: {\n      transcript: merged,\n      first_message_at: null,\n      last_message_at: toIso(lastTs),\n      checkpoint: toIso(lastTs),\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        0
      ],
      "id": "51073fa0-1642-4eac-a624-ce2d2ff1222c",
      "name": "Merge"
    },
