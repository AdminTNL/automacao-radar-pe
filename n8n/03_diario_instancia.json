        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "options": {},
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_instance_name: $('Trigger').item.json.instance_name, p_remote_jid: $('Loop Chats').item.json.id, p_contact_name: $('Loop Chats').item.json.name, p_phone: $('Loop Chats').item.json.id.replace('@s.whatsapp.net',''), p_first_message_at: $json.first_message_at, p_last_message_at: $json.last_message_at, p_checkpoint: $json.checkpoint, p_transcript: $json.transcript }) }}"
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        1200,
        0
      ],
      "id": "a8005cbb-6e80-4210-96c0-c36d75d3b3e0",
      "name": "Upsert Chat",
      "credentials": {
        "supabaseApi": {
          "id": "2s75u9F7plz4ovFN",
          "name": "Supabase account"
        }
      }
    }
